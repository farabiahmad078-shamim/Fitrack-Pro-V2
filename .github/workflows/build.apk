name: Build Android APK
on: [push]

jobs:
  build:
    runs-on: ubuntu-latest
    env:
      FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Set up JDK 21
        uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'

      - name: Install Dependencies
        run: npm install --force

      - name: Build Web Project
        run: |
          # প্রথমে নরমাল বিল্ড চেষ্টা করবে
          npm run build || true
          
          # যদি কোনো কারণে dist ফোল্ডার বা index.html তৈরি না হয়
          if [ ! -f "dist/index.html" ]; then
            mkdir -p dist
            # Lovable-এর index.html সঠিক জায়গা থেকে কপি করার চেষ্টা করবে
            cp index.html dist/ 2>/dev/null || cp src/index.html dist/ 2>/dev/null || cp public/index.html dist/ 2>/dev/null || true
            
            # যদি তাও না পাওয়া যায়, একটি ডামি index.html তৈরি করবে যাতে ক্যাপাসিটর ক্র্যাশ না করে
            if [ ! -f "dist/index.html" ]; then
              echo '<!DOCTYPE html><html><head><meta charset="UTF-8"><title>App</title></head><body><div id="root"></div></body></html>' > dist/index.html
            fi
          fi

      - name: Setup Capacitor Config
        run: |
          # আগের কোনো ভাঙা অ্যান্ড্রয়েড ফোল্ডার বা কনফিগারেশন থাকলে তা মুছে ফেলবে
          rm -rf android capacitor.config.json
          
          npm install @capacitor/core @capacitor/cli @capacitor/android
          
          cat <<EOF > capacitor.config.json
          {
            "appId": "com.ec.aoo",
            "appName": "Fitrackpro",
            "webDir": "dist",
            "server": {
              "androidScheme": "https",
              "hostname": "localhost",
              "cleartext": true
            }
          }
          EOF
          
          npx cap add android
          npx cap sync android

      - name: Build Android APK
        run: |
          cd android
          
          echo "configurations.all {
              resolutionStrategy.eachDependency { DependencyResolveDetails details ->
                  if (details.requested.group == 'org.jetbrains.kotlin') {
                      details.useVersion '1.8.22'
                  }
              }
          }" >> app/build.gradle
          
          chmod +x gradlew
          ./gradlew assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Mobile-App-APK
          path: android/app/build/outputs/apk/debug/app-debug.apk
